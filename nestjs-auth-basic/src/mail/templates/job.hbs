<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách việc làm</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
">

    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f4f4; padding: 30px 0;">
        <tr>
            <td align="center">

                <table width="600" cellspacing="0" cellpadding="0" border="0" style="
                        background-color: #ffffff;
                        border-radius: 8px;
                        overflow: hidden;
                    ">

                    <!-- HEADER -->
                    <tr>
                        <td style="
                                background-color: #1677ff;
                                padding: 25px;
                                text-align: center;
                                color: #ffffff;
                            ">
                            <h2 style="margin: 0;">
                                JOB HIRING
                            </h2>

                            <div style="margin-top: 8px; font-size: 14px;">
                                Danh sách công việc dành cho bạn
                            </div>
                        </td>
                    </tr>

                    <!-- GREETING -->
                    <tr>
                        <td style="padding: 25px 30px 10px 30px;">

                            <div style="
                                    font-size: 18px;
                                    font-weight: bold;
                                    color: #333333;
                                ">
                                Xin chào {{receiver}},
                            </div>

                            <div style="
                                    font-size: 14px;
                                    color: #666666;
                                    margin-top: 10px;
                                    line-height: 22px;
                                ">
                                Chúng tôi gửi đến bạn một số công việc
                                có thể phù hợp với kỹ năng và nhu cầu của bạn.
                            </div>

                        </td>
                    </tr>

                    <!-- JOB LIST -->
                    <tr>
                        <td style="padding: 10px 30px 30px 30px;">

                            <table width="100%" cellspacing="0" cellpadding="0" border="0">

                                {{#each jobs}}

                                <tr>
                                    <td style="
                                            padding: 20px 0;
                                            border-bottom: 1px dashed #cccccc;
                                        ">

                                        <!-- JOB NAME -->
                                        <div style="font-size: 18px; font-weight: bold;">

                                            <a href="http://localhost:3000" target="_blank" style="
                                                    color: #1677ff;
                                                    text-decoration: none;
                                                ">
                                                {{name}}
                                            </a>

                                        </div>

                                        <!-- COMPANY -->
                                        <div style="
                                                font-size: 14px;
                                                color: #555555;
                                                margin-top: 8px;
                                            ">
                                            <strong>Công ty:</strong>
                                            {{company}}
                                        </div>

                                        <!-- SALARY -->
                                        <div style="
                                                font-size: 14px;
                                                color: #555555;
                                                margin-top: 6px;
                                            ">
                                            <strong>Mức lương:</strong>
                                            {{salary}} VNĐ
                                        </div>

                                        <!-- SKILLS -->
                                        <div style="
                                                margin-top: 12px;
                                            ">

                                            {{#each skills}}

                                            <span style="
                                                    display: inline-block;
                                                    font-size: 13px;
                                                    background-color: #e6f4ff;
                                                    color: #1677ff;
                                                    padding: 5px 10px;
                                                    margin-right: 5px;
                                                    margin-bottom: 5px;
                                                    border-radius: 4px;
                                                ">
                                                {{this}}
                                            </span>

                                            {{/each}}

                                        </div>

                                    </td>
                                </tr>

                                {{/each}}

                            </table>

                        </td>
                    </tr>

                    <!-- BUTTON -->
                    <tr>
                        <td style="
                                padding: 0 30px 30px 30px;
                                text-align: center;
                            ">

                            <a href="http://localhost:3000" target="_blank" style="
                                    display: inline-block;
                                    width: 100%;
                                    box-sizing: border-box;
                                    background-color: #1677ff;
                                    color: #ffffff;
                                    text-decoration: none;
                                    padding: 13px 0;
                                    border-radius: 5px;
                                    font-size: 15px;
                                    font-weight: bold;
                                ">
                                Xem thêm việc làm
                            </a>

                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="
                                background-color: #f5f5f5;
                                text-align: center;
                                padding: 18px;
                                font-size: 12px;
                                color: #888888;
                            ">
                            Email này được gửi tự động từ hệ thống Job Hiring.
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>